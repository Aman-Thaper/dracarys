# DRACARYS configuration — copy to .env and adjust. Safe local-only defaults.
# All lab data is SYNTHETIC. Never put real secrets, credentials, or PII here.

# --- Core ---
DRACARYS_ENVIRONMENT=development
DRACARYS_DEBUG=true

# --- Database ---
# SQLite (zero-dependency local dev). For production use PostgreSQL:
#   DRACARYS_DATABASE_URL=postgresql+asyncpg://dracarys:dracarys_local_only@localhost:5432/dracarys
DRACARYS_DATABASE_URL=sqlite+aiosqlite:///./dracarys.db

# --- API server ---
DRACARYS_API_HOST=127.0.0.1
DRACARYS_API_PORT=8000
DRACARYS_CORS_ORIGINS=["http://localhost:3000"]

# --- Lab target (deliberately vulnerable; local-only) ---
DRACARYS_LAB_HOST=127.0.0.1
DRACARYS_LAB_PORT=8888
DRACARYS_LAB_PATCHED_PORT=8889

# --- Safety envelope (the guardrail against pointing DRACARYS off-lab) ---
# Offensive tooling may ONLY reach these hosts/ports; both are enforced.
DRACARYS_SCOPE_ALLOWLIST=["127.0.0.1","localhost","::1"]
DRACARYS_SCOPE_ALLOWED_PORTS=[8888,8889]
DRACARYS_MAX_REQUESTS_PER_CAMPAIGN=2000
DRACARYS_MAX_CONCURRENCY=8
DRACARYS_TOOL_TIMEOUT_SECONDS=10.0
DRACARYS_CAMPAIGN_BUDGET_SECONDS=600

# --- LLM planner (optional) ---
# "heuristic" (default, no key needed) or "anthropic".
# Findings are ALWAYS validated deterministically regardless of planner.
DRACARYS_LLM_PROVIDER=heuristic
# DRACARYS_ANTHROPIC_API_KEY=sk-ant-...
DRACARYS_LLM_MODEL=claude-sonnet-5
DRACARYS_LLM_MAX_TOKENS=2048

# --- Frontend ---
# Used by web/next.config.js to proxy /api to the backend.
DRACARYS_API_URL=http://127.0.0.1:8000
